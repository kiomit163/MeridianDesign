{
  "$schema": "https://design-tokens.org/schema.json",
  "$name": "Meridian Design System",
  "$version": "1.0.0",
  "$description": "面向欧美市场的企业级电商设计系统。三层令牌：primitive → semantic → component。tokens.css / tailwind-theme.css 由本文件派生，修改先改这里。",
  "color": {
    "primitive": {
      "ink": { "1": "#FBFCFE", "2": "#F6F8FA", "3": "#EFF2F6", "4": "#E6EAF0", "5": "#DBE0E8", "6": "#CBD2DC", "7": "#AEB7C4", "8": "#8E99AA", "9": "#66738A", "10": "#57647B", "11": "#5C6675", "12": "#1F2530" },
      "brand": { "1": "#F3FAF7", "2": "#E7F4EF", "3": "#D0E9DF", "4": "#B1DCCC", "5": "#8ECCB5", "6": "#6AB89C", "7": "#47A181", "8": "#2A8767", "9": "#0F6B57", "10": "#0C5949", "11": "#14664F", "12": "#0A3B30" },
      "accent": { "1": "#FDF8EE", "2": "#FAF0D9", "3": "#F4E1B6", "4": "#ECCE8B", "5": "#E3B95C", "6": "#D8A437", "7": "#C48D22", "8": "#A87510", "9": "#F2A20C", "10": "#D98E07", "11": "#96660A", "12": "#573906" },
      "info": { "1": "#F3F8FD", "2": "#E6F0FA", "3": "#CCE2F6", "4": "#A9CDF1", "5": "#80B4E9", "6": "#589AE0", "7": "#3580D3", "8": "#2268BB", "9": "#1E63C3", "10": "#1A54A6", "11": "#1B5AA8", "12": "#0E3A70" },
      "success": { "1": "#F2FBF6", "2": "#E4F6EC", "3": "#C9EBD8", "4": "#A4DDBE", "5": "#79CAA0", "6": "#52B582", "7": "#329C68", "8": "#228657", "9": "#178356", "10": "#136F49", "11": "#147550", "12": "#0A3D27" },
      "warning": { "1": "#FEF9EC", "2": "#FDF2D5", "3": "#FBE4AA", "4": "#F7D378", "5": "#F0BF48", "6": "#E5A926", "7": "#CD9316", "8": "#B07C0E", "9": "#EFB000", "10": "#D89B00", "11": "#8A6200", "12": "#48340A" },
      "danger": { "1": "#FEF5F4", "2": "#FEE9E8", "3": "#FCD4D3", "4": "#F8B4B5", "5": "#F19192", "6": "#E86B6D", "7": "#DC4A4E", "8": "#CD3336", "9": "#D2232C", "10": "#BB1D26", "11": "#BE1A22", "12": "#6E0E14" },
      "mystic": { "1": "#F8F5FE", "2": "#F0EAFC", "3": "#E3D6FA", "4": "#CDB9F7", "5": "#B49BF2", "6": "#9C80EC", "7": "#8667E4", "8": "#7151D7", "9": "#6C3FE0", "10": "#5C34C4", "11": "#5E30C8", "12": "#331A70" }
    },
    "surface-ranks-note": "背景是有序阶梯：inset(−2 凹槽) → chrome(−1 常驻框架) → surface(0 工作台面/卡片) → overlay(+1 浮层)。浅色下越亮=越靠前；框架内 hover/选中必须用 chrome-* 而非 surface-*（浅色下 surface-hover 与 chrome 同值，会导致 hover 不可见）。拓扑：记录型页面用 Canvas+Card，外壳型(多窗格)用 Chrome+Work-surface。",
    "semantic": {
      "light": {
        "bg-page": "#FFFFFF", "bg-surface": "#FFFFFF", "bg-surface-hover": "ink-2", "bg-surface-selected": "ink-3",
        "bg-inset": "ink-2", "bg-band": "ink-2", "bg-scrim": "rgb(15 18 24 / 0.48)",
        "bg-chrome": "#FFFFFF", "bg-chrome-hover": "ink-2", "bg-chrome-selected": "ink-3",
        "fg": "ink-12", "fg-muted": "ink-11", "fg-subtle": "ink-9", "fg-disabled": "ink-8", "fg-inverse": "#FFFFFF",
        "fg-link": "brand-11", "fg-link-hover": "brand-12",
        "border": "ink-5", "border-strong": "ink-6", "border-focus": "info-9",
        "primary": "brand-9", "primary-hover": "brand-10", "primary-active": "brand-10", "primary-fg": "#FFFFFF",
        "primary-text": "brand-11", "primary-tint": "brand-2", "primary-border": "brand-7",
        "success-fg": "success-11", "success-bg": "success-2", "success-border": "success-5", "success-solid": "success-9", "success-solid-fg": "#FFFFFF",
        "warning-fg": "warning-11", "warning-bg": "warning-2", "warning-border": "warning-5", "warning-solid": "warning-9", "warning-solid-fg": "#2B1F02",
        "critical-fg": "danger-11", "critical-bg": "danger-2", "critical-border": "danger-5", "critical-solid": "danger-9", "critical-solid-fg": "#FFFFFF",
        "info-fg": "info-11", "info-bg": "info-2", "info-border": "info-5", "info-solid": "info-9", "info-solid-fg": "#FFFFFF",
        "emphasis-fg": "accent-11", "emphasis-bg": "accent-2", "emphasis-border": "accent-5", "emphasis-solid": "accent-9", "emphasis-solid-fg": "#2B1F02",
        "ai-fg": "mystic-11", "ai-bg": "mystic-2",
        "price-sale": "danger-11", "price-compare": "ink-9", "price-fg": "ink-12"
      },
      "stage-overrides": {
        "storefront": {
          "note": "画廊舞台原则：前台主操作 = 中性近黑，商品图当主角（欧美 DTC 主流）；品牌色退守 logo/宣告条/营销区块。组件 API 不变，仅舞台层重指向。",
          "primary": "ink-12", "primary-hover": "color-mix(ink-12 86%, #FFF)", "primary-active": "color-mix(ink-12 94%, #FFF)",
          "primary-fg": "#FFFFFF", "primary-text": "ink-12", "primary-tint": "ink-2", "primary-border": "ink-7",
          "fg-link": "ink-12", "fg-link-hover": "ink-9",
          "dark": {
            "primary": "ink-2", "primary-hover": "ink-4", "primary-active": "ink-5",
            "primary-fg": "ink-12", "primary-text": "ink-2", "fg-link": "ink-2"
          }
        },
        "admin": { "note": "后台保持品牌绿 primary（brand-9），运营工具需要品牌识别度（Polaris 同哲学）。" }
      },
      "dark": {
        "bg-page": "#0F1216", "bg-surface": "#161A20", "bg-surface-hover": "#1C2129", "bg-surface-selected": "#232935",
        "bg-inset": "#10141A", "bg-band": "#10141A", "bg-scrim": "rgb(0 0 0 / 0.6)",
        "bg-chrome": "#0F1216", "bg-chrome-hover": "#1A1F27", "bg-chrome-selected": "#232A35",
        "fg": "#F1F3F6", "fg-muted": "#AEB7C4", "fg-subtle": "#8E99AA", "fg-disabled": "#5C6675", "fg-inverse": "#161A20",
        "fg-link": "brand-4", "fg-link-hover": "brand-3",
        "border": "#262C36", "border-strong": "#363D49", "border-focus": "info-5",
        "primary": "brand-9", "primary-hover": "brand-8", "primary-active": "brand-7", "primary-fg": "#FFFFFF",
        "primary-text": "brand-4", "primary-tint": "rgb(15 107 87 / 0.16)", "primary-border": "brand-6",
        "success-fg": "success-4", "success-bg": "rgb(23 131 86 / 0.16)", "success-border": "rgb(23 131 86 / 0.45)", "success-solid": "success-9", "success-solid-fg": "#FFFFFF",
        "warning-fg": "warning-4", "warning-bg": "rgb(239 176 0 / 0.14)", "warning-border": "rgb(239 176 0 / 0.45)", "warning-solid": "warning-9", "warning-solid-fg": "#2B1F02",
        "critical-fg": "danger-4", "critical-bg": "rgb(210 35 44 / 0.16)", "critical-border": "rgb(210 35 44 / 0.45)", "critical-solid": "danger-9", "critical-solid-fg": "#FFFFFF",
        "info-fg": "info-4", "info-bg": "rgb(30 99 195 / 0.16)", "info-border": "rgb(30 99 195 / 0.45)", "info-solid": "info-9", "info-solid-fg": "#FFFFFF",
        "emphasis-fg": "accent-4", "emphasis-bg": "rgb(242 162 12 / 0.14)", "emphasis-border": "rgb(242 162 12 / 0.45)", "emphasis-solid": "accent-9", "emphasis-solid-fg": "#2B1F02",
        "ai-fg": "mystic-4", "ai-bg": "rgb(108 63 224 / 0.16)",
        "price-sale": "danger-4", "price-compare": "ink-8", "price-fg": "#F1F3F6"
      }
    }
  },
  "typography": {
    "font-sans": "Inter Variable, Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "font-display": "var(--m-font-sans)",
    "font-mono": "ui-monospace, 'SF Mono', 'JetBrains Mono', Menlo, Consolas, monospace",
    "weights": { "regular": 450, "medium": 550, "semibold": 650, "bold": 700 },
    "sizes-px": { "xs": [12, 16], "sm": [13, 20], "md": [14, 20], "lg": [16, 24], "xl": [18, 28], "2xl": [20, 28], "3xl": [24, 32], "4xl": [30, 38], "5xl": [36, 44], "6xl": [44, 52] },
    "display-clamp": "clamp(2.25rem, 1.6rem + 2.6vw, 3.75rem)",
    "tracking": { "tight": "-0.02em", "tightest": "-0.035em" },
    "rules": ["正文最小 12px，禁止更小", "价格/表格数字必须 tabular-nums", "后台正文 = md(14px)，前台正文 = lg(16px)", "标题行高 = 4px 网格"]
  },
  "space": {
    "base-px": 4,
    "scale": { "0": 0, "05": 2, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64, "20": 80, "24": 96 },
    "section-clamp": "clamp(3rem, 2rem + 4vw, 6rem)"
  },
  "radius": { "knob": 8, "scale-px": { "xs": 2, "sm": 4, "md": 8, "lg": 12, "xl": 16, "2xl": 24, "pill": 9999 } },
  "elevation": {
    "e1": "卡片/悬浮提示（后台默认禁用，前台卡片使用）",
    "e2": "下拉/Popover",
    "e3": "抽屉/模态",
    "e4": "Toast/最顶层",
    "z-ladder": { "raised": 10, "nav": 100, "drawer": 300, "modal": 400, "toast": 500, "tooltip": 600 }
  },
  "motion": {
    "duration-ms": { "100": "微交互", "150": "hover 标准", "200": "焦点/小面板", "300": "抽屉/弹层进入", "450": "大面积", "600": "前台表达性" },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0.05, 0.7, 0.1, 1)",
      "exit": "cubic-bezier(0.3, 0, 0.8, 0.15)"
    },
    "state-layer-opacity": { "hover": "8%", "pressed": "12%", "selected": "10%", "dragged": "16%" }
  },
  "breakpoints-px": { "xs": 480, "sm": 768, "md": 1024, "lg": 1280, "xl": 1440 },
  "container": { "storefront": 1280, "admin": 1000, "narrow": 640 },
  "a11y-contract": {
    "target-size-min-px": 24,
    "target-size-touch-px": 44,
    "contrast": { "body-text": "4.5:1", "large-text": "3:1", "ui-component": "3:1", "focus-indicator": "3:1" },
    "focus-ring": { "width": "2px", "offset": "2px", "admin": "内嵌式（offset -1px），参照 Polaris" }
  }
}
